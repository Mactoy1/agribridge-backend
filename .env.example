# Server Configuration
PORT=5000
NODE_ENV=development

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production_use_at_least_32_characters

# Database Configuration
# PostgreSQL connection string
# Format: postgresql://username:password@host:port/database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/agribridge"

# AI Configuration
# Google Gemini API key (optional, if not provided, will use fallback forecasts)
GEMINI_API_KEY=your_google_gemini_api_key_here
